# ==============================================================================
# NICHE CONTENT ENGINE - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local and fill in your private API keys and tokens.
# cp .env.example .env.local
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & HOSTING ENVIRONMENT
# ------------------------------------------------------------------------------
# Runtime environment ('development', 'production', or 'test')
NODE_ENV=development

# Vercel Deployment Flag (automatically set when deployed on Vercel)
VERCEL=

# AWS Lambda Runtime Identifier (set automatically if running in serverless container)
AWS_LAMBDA_FUNCTION_NAME=

# ------------------------------------------------------------------------------
# 2. AI PROVIDER API KEYS
# ------------------------------------------------------------------------------
# Groq Cloud API Key (Primary LLM for discovery, reasoning, and captioning)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (Secondary fallback for LLM operations)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# OpenAI API Key (Tertiary fallback and DALL-E 3 image generation)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Pollinations API Key (Optional custom key for AI image generation fallback)
POLLINATIONS_API_KEY=

# ------------------------------------------------------------------------------
# 3. SOCIAL MEDIA & DISTRIBUTION TOKENS
# ------------------------------------------------------------------------------
# TikTok API V2 Client Credentials (for direct video & photo publishing)
# Manage at: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# Instagram Graph API Credentials (Instagram Business / Professional Account)
# Manage at: https://developers.facebook.com/
INSTAGRAM_ACCESS_TOKEN=your_instagram_user_or_system_user_access_token
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id

# Facebook Graph API Credentials (Page Publishing)
# Manage at: https://developers.facebook.com/
FACEBOOK_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
FACEBOOK_PAGE_ID=your_facebook_page_id

# Twitter / X API v2 Credentials (OAuth 1.0a User Context)
# Manage at: https://developer.x.com/en/portal/dashboard
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
TWITTER_ACCESS_TOKEN=your_twitter_access_token
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret

# ------------------------------------------------------------------------------
# 4. DATABASE, CMS & STORAGE
# ------------------------------------------------------------------------------
# Redis Connection URI (for persistent post storage, analytics & rate limiting)
# e.g., rediss://default:password@region.upstash.io:6379 or redis://localhost:6379
REDIS_URL=redis://localhost:6379

# Vercel KV Storage Connection URL (Alternative to REDIS_URL when using Vercel KV)
KV_URL=

# WordPress REST API Publishing Credentials (Optional)
WP_BASE_URL=https://yourblog.wordpress.com
WP_APP_PASSWORD=your_wordpress_application_password

# Sanity.io Headless CMS Project ID (Optional)
SANITY_PROJECT_ID=

# Google Service Account JSON (Base64 encoded) for Google Search Indexing API
# Base64 string of service-account-key.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------------------------
# 5. SECURITY, CRON & AFFILIATES
# ------------------------------------------------------------------------------
# Secret token for authenticating Vercel / external cron jobs (/api/cron/daily)
CRON_SECRET=your_secure_cron_secret_string

# Amazon / Affiliate tracking tag inserted into generated product recommendations
AFFILIATE_TAG=niche-engine-20

# ------------------------------------------------------------------------------
# 6. PUBLIC CLIENT VARIABLES (NEXT_PUBLIC_*)
# ------------------------------------------------------------------------------
# Comma-separated list of Clerk user emails allowed to access admin routes
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com,developer@company.com

# Public application base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Facebook App ID (Optional client tracking / SDK)
NEXT_PUBLIC_FB_APP_ID=
